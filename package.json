{
  "name": "meetless-cli",
  "license": "Apache-2.0",
  "private": true,
  "description": "Workspace root for the Meetless CLI. This container is not published; the released package is packages/cli (@meetless/mla), which carries the shipped version.",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run build && pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "plugin:sync": "pnpm --filter @meetless/mla... build && node scripts/sync-plugin.mjs",
    "plugin:check": "pnpm --filter @meetless/mla... build && node scripts/sync-plugin.mjs --check",
    "plugin:validate": "pnpm plugin:check && node scripts/validate-plugin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
